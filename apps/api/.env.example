# Local demo ignores .env files and needs no provider keys. Use pnpm dev:demo.
# pnpm dev (or pnpm dev:groq) enables Groq for local testing.
# Automated tests use demo mode; public-release review remains separate.
# Copy to .env and fill in your own values. Never commit .env, never paste
# its contents in chat or in any tool call.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Eval only (eval/runner.ts --model claude-*). The app itself never calls
# Anthropic; this key exists so the same suite can be run against a second
# provider for model comparison.
ANTHROPIC_API_KEY=
# Only for an account-level key. A workspace-scoped key needs no value here
# and will reject the header if one is set.
ANTHROPIC_WORKSPACE_ID=

# Eval only, alternative transport: spends the subscription's programmatic
# credit instead of Console credits. Generate with `claude setup-token`.
# The runner removes ANTHROPIC_API_KEY from its own environment when this
# transport is used, because a Console key would otherwise take precedence.
CLAUDE_CODE_OAUTH_TOKEN=
PORT=3000
WEB_ORIGIN=http://localhost:5173

# Optional bounded runtime settings (shell overrides also work in demo).
MAX_CONCURRENT_REQUESTS=3
MAX_REQUESTS_PER_PROCESS=1000
REQUEST_TIMEOUT_MS=20000
